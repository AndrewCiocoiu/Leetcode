
ITERATIVE-TREE-HEIGHT(root)
    if root == nil
        return -1

    max_height = -1
    curr_height = 1
    curr = root    

    while curr != nil
        max_height = max(curr_height, max_height)

        if d == 1
            if left[curr] != nil
                curr_height += 1
                curr = left[curr]
            else
                d = 2
        
        else if d == 2
            if right[curr] != nil
                curr_height += 1
                curr = right[curr]
            else d = 3
        else if d == 3
            if p[curr] != nil
                if curr == left[p[curr]]
                    d = 2
                else
                    d = 3
            curr = p[curr]
            curr_height -= 1
    
    return max_height